}
$Field = @{
  pkg = [Guid]'71bc78fa-f17c-4997-a602-6abb261f351c'
  proto = [Guid]'3971ef2b-623e-4f9a-8cb1-6e79b806b9a7'
  raddr = [Guid]'b235ae9a-1d64-49b8-a44c-5ff3d9095045'
  rport = [Guid]'c35a604d-d22b-4e1a-91b4-68f674ee674b'
  laddr = [Guid]'d9ee00de-c1ef-4617-bfe3-ffd8f5a08957'
  lport = [Guid]'0c1ba1af-5765-453f-af22-a8f791ac775b'
