# id|layer|action|conditions besides the package
$Rules = @(
@@RULES@@
)
$Acl = @(@@ACL@@)
$Writers = @(@@WRITERS@@)
$WriteMask = 1343029590
$NotFoundFilter = [UInt32]2150760451
$NotFoundProvider = [UInt32]2150760453
$NotFoundSublayer = [UInt32]2150760455
$Exists = [UInt32]2150760457
$Dir = [IO.Path]::Combine([Environment]::GetFolderPath('ProgramFiles'), '@@DIR@@')
