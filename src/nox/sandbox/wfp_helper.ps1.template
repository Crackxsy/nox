for ($i = 0; $i -lt 16; $i++) { $NsBytes[$i] = [Convert]::ToByte($NsHex.Substring(2 * $i, 2), 16) }

function SidOf([string]$name) {
  $d = [Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::Unicode.GetBytes($name.ToLowerInvariant()))
  $b = [byte[]]::new(40)
  $b[0] = 1; $b[1] = 8; $b[7] = 15; $b[8] = 2
  [Array]::Copy($d, 0, $b, 12, 28)
  $s = 'S-1-15-2'
  for ($i = 0; $i -lt 7; $i++) { $s += '-' + [BitConverter]::ToUInt32($d, 4 * $i) }
  return @{ Bytes = $b; Text = $s }
}

function KeyOf([string]$name) {
  $n = [Text.Encoding]::UTF8.GetBytes($name)
  $data = [byte[]]::new(16 + $n.Length)
  [Array]::Copy($NsBytes, 0, $data, 0, 16)
  [Array]::Copy($n, 0, $data, 16, $n.Length)
  $h = [Security.Cryptography.SHA1]::Create().ComputeHash($data)
  $h[6] = ($h[6] -band 0x0F) -bor 0x50
  $h[8] = ($h[8] -band 0x3F) -bor 0x80
  $x = [BitConverter]::ToString($h, 0, 16).Replace('-', '').ToLowerInvariant()
  return [Guid]($x.Substring(0, 8) + '-' + $x.Substring(8, 4) + '-' + $x.Substring(12, 4) + '-' + $x.Substring(16, 4) + '-' + $x.Substring(20))
}

function AllRules {
  $all = [Collections.Generic.List[object]]::new()
  foreach ($name in $Names) {
    $sid = SidOf $name
    foreach ($r in $Rules) {
      $p = $r.Split('|')
      $conds = @()
      if ($p[3]) { $conds = $p[3].Split(',') }
      $w = @@PERMIT_W@@
      if ($p[2] -eq 'BLOCK') { $w = @@BLOCK_W@@ }
      $all.Add(@{ Key = (KeyOf ($name + '|' + $p[0])); Name = 'Nox sandbox ' + $name + ': ' + $p[0]; Layer = $p[1]; Action = $p[2]; Weight = $w; Sid = $sid; Conds = $conds })
    }
  }
  return , $all
}

function Line($r) {
  $hard = ''
  if ($r.Action -eq 'BLOCK') { $hard = ' (hard)' }
  $s = '{0} {1} {2}{3} w={4} package={5}' -f $r.Key, $r.Layer, $r.Action, $hard, $r.Weight, $r.Sid.Text
  foreach ($c in $r.Conds) { $s += ' ' + $CondText[$c] }
  return $s
}

function Native {
  $ab = [AppDomain]::CurrentDomain.DefineDynamicAssembly([Reflection.AssemblyName]::new('NoxWfp'), [Reflection.Emit.AssemblyBuilderAccess]::Run)
  $tb = $ab.DefineDynamicModule('NoxWfp').DefineType('NoxWfpNative', [Reflection.TypeAttributes]'Public, Class')
  $P = [IntPtr]; $U = [UInt32]
  $sigs = @{
    FwpmEngineOpen0 = @($P, $U, $P, $P, $P); FwpmEngineClose0 = @($P)
    FwpmTransactionBegin0 = @($P, $U); FwpmTransactionCommit0 = @($P); FwpmTransactionAbort0 = @($P)
    FwpmProviderAdd0 = @($P, $P, $P); FwpmProviderGetByKey0 = @($P, $P, $P); FwpmProviderDeleteByKey0 = @($P, $P)
    FwpmSubLayerAdd0 = @($P, $P, $P); FwpmSubLayerDeleteByKey0 = @($P, $P)
    FwpmFilterAdd0 = @($P, $P, $P, $P); FwpmFilterDeleteByKey0 = @($P, $P)
    FwpmFilterCreateEnumHandle0 = @($P, $P, $P); FwpmFilterEnum0 = @($P, $P, $U, $P, $P)
    FwpmFilterDestroyEnumHandle0 = @($P, $P); FwpmFreeMemory0 = @($P)
  }
  $dll = [IO.Path]::Combine([Environment]::SystemDirectory, 'fwpuclnt.dll')
  foreach ($k in $sigs.Keys) {
    $m = $tb.DefinePInvokeMethod($k, $dll, [Reflection.MethodAttributes]'Public, Static, PinvokeImpl', [Reflection.CallingConventions]::Standard, [UInt32], [Type[]]$sigs[$k], [Runtime.InteropServices.CallingConvention]::Winapi, [Runtime.InteropServices.CharSet]::Unicode)
    $m.SetImplementationFlags([Reflection.MethodImplAttributes]::PreserveSig)
  }
  return $tb.CreateType()
}

function Check([string]$call, [UInt32]$code, [UInt32[]]$ok = @()) {
  if ($code -ne 0 -and $ok -notcontains $code) {
    $hint = ''
    if ($code -eq 5) { $hint = ' (run it as administrator)' }
    throw ('{0} failed with 0x{1:x8}{2}' -f $call, $code, $hint)
  }
  return $code
}

function Alloc([int]$n) {
  $p = $M::AllocHGlobal($n)
  $M::Copy([byte[]]::new($n), 0, $p, $n)
  $Mem.Add($p)
  return $p
}
function At([IntPtr]$p, [int]$off) { return [IntPtr]($p.ToInt64() + $off) }
function GuidAt([IntPtr]$p, [int]$off, [Guid]$g) { $M::Copy($g.ToByteArray(), 0, (At $p $off), 16) }
function GuidFrom([IntPtr]$p, [int]$off) {
  $b = [byte[]]::new(16)
  $M::Copy((At $p $off), $b, 0, 16)
  return [Guid]::new($b)
}
function PtrGuid([Guid]$g) { $p = Alloc 16; GuidAt $p 0 $g; return $p }
function Str([string]$s) { $p = $M::StringToHGlobalUni($s); $Mem.Add($p); return $p }
function Blob([byte[]]$b) { $p = Alloc $b.Length; $M::Copy($b, 0, $p, $b.Length); return $p }

function Open {
  $pe = Alloc 8
  [void](Check 'FwpmEngineOpen0' ($N::FwpmEngineOpen0([IntPtr]::Zero, [UInt32]10, [IntPtr]::Zero, [IntPtr]::Zero, $pe)))
  return $M::ReadIntPtr($pe)
}

function ProviderFilters($E) {
  $found = [Collections.Generic.HashSet[Guid]]::new()
  $pk = PtrGuid $Provider
  foreach ($layer in $Layers.Values) {
    $t = Alloc 72
    $M::WriteIntPtr($t, 0, $pk); GuidAt $t 8 $layer; $M::WriteInt32($t, 24, 1); $M::WriteInt32($t, 56, -1)
    $ph = Alloc 8
    [void](Check 'FwpmFilterCreateEnumHandle0' ($N::FwpmFilterCreateEnumHandle0($E, $t, $ph)))
    $h = $M::ReadIntPtr($ph)
    try {
      while ($true) {
        $pp = Alloc 8; $pc = Alloc 4
        [void](Check 'FwpmFilterEnum0' ($N::FwpmFilterEnum0($E, $h, [UInt32]256, $pp, $pc)))
        $entries = $M::ReadIntPtr($pp); $count = $M::ReadInt32($pc)
        try {
          for ($i = 0; $i -lt $count; $i++) {
            $f = $M::ReadIntPtr($entries, 8 * $i)
            $owner = $M::ReadIntPtr($f, 40)
            if ($owner -ne [IntPtr]::Zero -and (GuidFrom $owner 0) -eq $Provider) { [void]$found.Add((GuidFrom $f 0)) }
          }
        } finally {
          if ($entries -ne [IntPtr]::Zero) { [void]$N::FwpmFreeMemory0($pp) }
        }
        if ($count -lt 256) { break }
      }
    } finally {
      [void]$N::FwpmFilterDestroyEnumHandle0($E, $h)
    }
  }
  return , $found
}

function CondAt([IntPtr]$a, [int]$off, [string]$kind, $sid) {
  $p = At $a $off
  GuidAt $p 0 $Field[$kind]
  if ($kind -eq 'pkg') { $M::WriteInt32($p, 24, 13); $M::WriteIntPtr($p, 32, (Blob $sid)) }
  elseif ($kind -eq 'proto') { $M::WriteInt32($p, 24, 1); $M::WriteByte($p, 32, [byte]@@TCP@@) }
  elseif ($kind -eq 'raddr' -or $kind -eq 'laddr') {
    $v = Alloc 8
    $M::WriteInt32($v, 0, 0x7F000001); $M::WriteInt32($v, 4, -1)
    $M::WriteInt32($p, 24, 256); $M::WriteIntPtr($p, 32, $v)
  } else {
    $v = Alloc 32
    $M::WriteInt32($v, 0, 2); $M::WriteInt16($v, 8, [int16]$Lo)
    $M::WriteInt32($v, 16, 2); $M::WriteInt16($v, 24, [int16]$Hi)
    $M::WriteInt32($p, 16, 5); $M::WriteInt32($p, 24, 258); $M::WriteIntPtr($p, 32, $v)
  }
}

function AddFilter($E, $r, [IntPtr]$pk) {
  $conds = @($r.Conds)
  $n = 1 + $conds.Count
  $ca = Alloc (40 * $n)
  CondAt $ca 0 'pkg' $r.Sid.Bytes
  for ($i = 0; $i -lt $conds.Count; $i++) { CondAt $ca (40 * ($i + 1)) $conds[$i] $null }
  $f = Alloc 200
  GuidAt $f 0 $r.Key
  $M::WriteIntPtr($f, 16, (Str $r.Name)); $M::WriteIntPtr($f, 24, (Str $Desc))
  $flags = 1; $act = 4098
  if ($r.Action -eq 'BLOCK') { $flags = 9; $act = 4097 }
  $M::WriteInt32($f, 32, $flags)
  $M::WriteIntPtr($f, 40, $pk)
  GuidAt $f 64 $Layers[$r.Layer]
  GuidAt $f 80 $Sublayer
  $M::WriteInt32($f, 96, 1); $M::WriteByte($f, 104, [byte]$r.Weight)
  $M::WriteInt32($f, 112, $n); $M::WriteIntPtr($f, 120, $ca)
  $M::WriteInt32($f, 128, $act)
  [void](Check ('FwpmFilterAdd0(' + $r.Name + ')') ($N::FwpmFilterAdd0($E, $f, [IntPtr]::Zero, [IntPtr]::Zero)))
}

function Change([bool]$add) {
  $E = Open
  try {
    [void](Check 'FwpmTransactionBegin0' ($N::FwpmTransactionBegin0($E, [UInt32]0)))
    try {
      $pk = PtrGuid $Provider
      $rules = AllRules
      if ($add) {
        $pv = Alloc 64
        GuidAt $pv 0 $Provider; $M::WriteIntPtr($pv, 16, (Str 'Nox')); $M::WriteIntPtr($pv, 24, (Str $Desc)); $M::WriteInt32($pv, 32, 1)
        [void](Check 'FwpmProviderAdd0' ($N::FwpmProviderAdd0($E, $pv, [IntPtr]::Zero)) $Exists)
        $sl = Alloc 72
        GuidAt $sl 0 $Sublayer; $M::WriteIntPtr($sl, 16, (Str 'Nox sandbox')); $M::WriteIntPtr($sl, 24, (Str $Desc))
        $M::WriteInt32($sl, 32, 1); $M::WriteIntPtr($sl, 40, $pk); $M::WriteInt16($sl, 64, [int16]-1)
        [void](Check 'FwpmSubLayerAdd0' ($N::FwpmSubLayerAdd0($E, $sl, [IntPtr]::Zero)) $Exists)
      }
      # Every filter of Nox's provider goes, also ones an older build or another tool added.
      $keys = ProviderFilters $E
      foreach ($r in $rules) { [void]$keys.Add($r.Key) }
      $removed = 0
      foreach ($k in $keys) {
        if ((Check 'FwpmFilterDeleteByKey0' ($N::FwpmFilterDeleteByKey0($E, (PtrGuid $k))) $NotFoundFilter) -eq 0) { $removed++ }
      }
      if ($add) {
        foreach ($r in $rules) { AddFilter $E $r $pk }
        $result = $rules.Count
      } else {
        [void](Check 'FwpmSubLayerDeleteByKey0' ($N::FwpmSubLayerDeleteByKey0($E, (PtrGuid $Sublayer))) $NotFoundSublayer)
        [void](Check 'FwpmProviderDeleteByKey0' ($N::FwpmProviderDeleteByKey0($E, $pk)) $NotFoundProvider)
        $result = $removed
      }
      [void](Check 'FwpmTransactionCommit0' ($N::FwpmTransactionCommit0($E)))
      return $result
    } catch {
      [void]$N::FwpmTransactionAbort0($E)
      throw
    }
  } finally {
    [void]$N::FwpmEngineClose0($E)
  }
}

function Present {
  $E = Open
  try {
    $pp = Alloc 8
    $code = Check 'FwpmProviderGetByKey0' ($N::FwpmProviderGetByKey0($E, (PtrGuid $Provider), $pp)) $NotFoundProvider
    if ($code -eq 0) { [void]$N::FwpmFreeMemory0($pp); return $true }
    return $false
  } finally {
    [void]$N::FwpmEngineClose0($E)
  }
}

function IsAdmin {
  return ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Sid([string]$s) { return [Security.Principal.SecurityIdentifier]::new($s) }

function AssertAdminOnly($sec, [string]$what) {
  $owner = $sec.GetOwner([Security.Principal.SecurityIdentifier]).Value
  if ($Writers -notcontains $owner) { throw ($what + ': owned by ' + $owner) }
  foreach ($rule in $sec.GetAccessRules($true, $true, [Security.Principal.SecurityIdentifier])) {
    $who = $rule.IdentityReference.Value
    if ($rule.AccessControlType -eq [Security.AccessControl.AccessControlType]::Allow -and $Writers -notcontains $who -and (([int]$rule.FileSystemRights) -band $WriteMask) -ne 0) {
      throw ($what + ': ' + $who + ' may change it')
    }
  }
}

function Protect {
  if ($null -eq $Self) { return }
  if ([IO.Directory]::Exists($Dir)) {
    if (([IO.File]::GetAttributes($Dir) -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw ($Dir + ' is a reparse point') }
  } else {
    [void][IO.Directory]::CreateDirectory($Dir)
  }
  $sec = [Security.AccessControl.DirectorySecurity]::new()
  $sec.SetAccessRuleProtection($true, $false)
  $sec.SetOwner((Sid 'S-1-5-32-544'))
  foreach ($a in $Acl) {
    $p = $a.Split('=')
    $sec.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new((Sid $p[0]), [Security.AccessControl.FileSystemRights]$p[1], [Security.AccessControl.InheritanceFlags]'ContainerInherit, ObjectInherit', [Security.AccessControl.PropagationFlags]::None, [Security.AccessControl.AccessControlType]::Allow))
  }
  [IO.Directory]::SetAccessControl($Dir, $sec)
  if ([IO.File]::Exists($File)) { [IO.File]::Delete($File) }
  [IO.File]::WriteAllBytes($File, $Self)
  $fs = [IO.File]::GetAccessControl($File)
  $fs.SetOwner((Sid 'S-1-5-32-544'))
  $fs.SetAccessRuleProtection($false, $false)
  [IO.File]::SetAccessControl($File, $fs)
  AssertAdminOnly ([IO.Directory]::GetAccessControl($Dir)) $Dir
  AssertAdminOnly ([IO.File]::GetAccessControl($File)) $File
}

function SetStatus([string]$what, [int]$code, [string]$msg, [int]$count) {
  $k = [Microsoft.Win32.Registry]::LocalMachine.CreateSubKey($RegPath)
  try {
    $seq = 0
    $old = $k.GetValue('Sequence')
    if ($null -ne $old) { $seq = [int]$old }
    $k.SetValue('Sequence', $seq + 1, [Microsoft.Win32.RegistryValueKind]::DWord)
    $k.SetValue('Action', $what)
    $k.SetValue('Code', $code, [Microsoft.Win32.RegistryValueKind]::DWord)
    $k.SetValue('Message', $msg)
    $k.SetValue('Filters', $count, [Microsoft.Win32.RegistryValueKind]::DWord)
  } finally {
    $k.Close()
  }
}

function Forget {
  [Microsoft.Win32.Registry]::LocalMachine.DeleteSubKeyTree($RegPath, $false)
  $parent = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey('@@REGPARENT@@')
  if ($null -ne $parent) {
    $empty = $parent.SubKeyCount -eq 0 -and $parent.ValueCount -eq 0
    $parent.Close()
    if ($empty) { [Microsoft.Win32.Registry]::LocalMachine.DeleteSubKey('@@REGPARENT@@', $false) }
  }
  if ([IO.Directory]::Exists($Dir) -and ([IO.File]::GetAttributes($Dir) -band [IO.FileAttributes]::ReparsePoint) -eq 0) { [IO.Directory]::Delete($Dir, $true) }
}

$N = $null
try {
  if ($Action -eq 'show') {
    foreach ($r in (AllRules)) { [Console]::Out.WriteLine((Line $r)) }
    exit 0
  }
  if ([Environment]::Is64BitOperatingSystem -and -not [Environment]::Is64BitProcess) { throw 'run the 64-bit Windows PowerShell (System32)' }
  $N = Native
  if ($Action -eq 'status') {
    if (Present) { [Console]::Out.WriteLine('present'); exit 0 }
    [Console]::Out.WriteLine('absent')
    exit 1
  }
  if ('install', 'remove', 'uninstall' -notcontains $Action) { throw ('unknown action ' + $Action) }
  if (-not (IsAdmin)) { throw 'needs an administrator' }
  if ($Action -eq 'install') {
    Protect
    $n = Change $true
    SetStatus 'install' 0 ('installed ' + $n + ' filter(s)') $n
    [Console]::Out.WriteLine('sandbox network rules: installed ' + $n + ' filter(s)')
  } else {
    $n = Change $false
    if ($Action -eq 'uninstall') { Forget } else { SetStatus 'remove' 0 ('removed ' + $n + ' filter(s)') 0 }
    [Console]::Out.WriteLine('sandbox network rules: removed ' + $n + ' filter(s)')
  }
  exit 0
} catch {
  $msg = $_.Exception.Message
  try { if ($Action -eq 'install' -and (IsAdmin)) { SetStatus $Action 1 $msg 0 } } catch { }
  [Console]::Error.WriteLine('sandbox network rules: ' + $msg)
  exit 2
} finally {
  foreach ($p in $Mem) { $M::FreeHGlobal($p) }
}
