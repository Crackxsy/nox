# Nox as a node on a Linux desktop: a systemd *user* unit - it runs as the person logged in, never
# as root, and starts with their session. Written by `scripts/install-linux.sh --node` (@PREFIX@ is
# replaced by the install folder, ~/.local/share/nox-node-app); see docs/NODES.md.
#
# The launcher (installer/start_node.pyw) chooses between the installed version and one the node
# installed itself from a signed release, restarts the node after an update and rolls a new
# version back when it does not start. An unpaired node ends at once; `nox-node pair` restarts it.
#
# The node belongs to the graphical session: started with it where the desktop starts
# graphical-session.target (GNOME, KDE Plasma and others), stopped when the session ends (PartOf),
# and at login (default.target) everywhere else. It reads the session's display when it needs it
# (DISPLAY / WAYLAND_DISPLAY from the user manager, nox.node.confirm.has_screen), so a node that
# started before the session still asks its questions on the screen once the session is there.

[Unit]
Description=Nox node - this PC as the hands of the Nox at home
Documentation=https://github.com/Crackxsy/nox/blob/develop/docs/NODES.md
After=network-online.target graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# A trusted working folder: the installed program, never wherever the session started.
WorkingDirectory=@PREFIX@/current
# -I: isolated - no current folder, user site or PYTHON* variable decides what is imported.
ExecStart="@PREFIX@/current/.venv/bin/python" -I "@PREFIX@/current/installer/start_node.pyw"
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=default.target graphical-session.target
