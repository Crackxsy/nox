# Nox-OS root helper, one per request (nox-os-helper.socket). Three requests and nothing else:
# status, ssh off, ssh on <minutes> + public keys (nox_os_helper.py).
[Unit]
Description=Nox-OS root helper (one request)
CollectMode=inactive-or-failed

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -S /usr/local/lib/nox-os/nox_os_helper.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=nox-os-helper
TimeoutStartSec=90
# It writes only under /run/nox-os and its own /var/lib/nox-os, and talks only to systemd.
ProtectSystem=strict
ReadWritePaths=/run/nox-os -/var/lib/nox-os
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Is the asking process still the one that connected (its pidfd)? One passphrase check at a time
# (flock).
SystemCallFilter=pidfd_send_signal flock
CapabilityBoundingSet=
