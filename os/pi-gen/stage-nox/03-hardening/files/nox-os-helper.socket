# Nox-OS root helper (nox_os_helper.py): reachable by root and the group nox only, and it answers
# only root and nox.service's main process (os/README.md, "Remote maintenance").
[Unit]
Description=Nox-OS root helper socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/nox-os/helper/helper.sock
SocketUser=root
SocketGroup=nox
SocketMode=0660
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
